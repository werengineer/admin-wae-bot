# Admin WAE Bot (mobile app). Copy this file to .env and fill it in. EXPO_PUBLIC_* values are put INTO the app: they are not secret.
# Never put the WAE Bot server token here: it stays on the server of the web gateway.

# The web gateway: the Admin WAE Bot web app (or the Academy app) that has /api/wae-bot/*, deployed with a public https address.
# A phone cannot reach http://localhost:3001 of your computer; use the deployed address (or your computer's LAN address while testing).
EXPO_PUBLIC_GATEWAY_URL=

# Login: the same Supabase project as the web app (anon key only).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
